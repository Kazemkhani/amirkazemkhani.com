{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/work/index.html"
    },
    {
      "source": "/keel",
      "destination": "/keel/index.html"
    },
    {
      "source": "/keel/",
      "destination": "/keel/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
